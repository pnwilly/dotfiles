#!/usr/bin/env bash
#
# Claude Code PostToolUse hook: lint the file just edited with the linter its
# repo already configures, and feed violations back to the agent (exit 2).
#
# Report only — never rewrites the file, so a one-line edit cannot turn into
# whole-file formatting churn. Silent when the repo configures no linter or the
# linter is not installed.
set -uo pipefail

file=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("tool_input",{}).get("file_path",""))' 2>/dev/null)
[[ -n $file && -f $file ]] || exit 0

root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null) || exit 0

has_ruff_config() {
  [[ -f $root/ruff.toml || -f $root/.ruff.toml ]] ||
    grep -q '^\[tool\.ruff' "$root/pyproject.toml" 2>/dev/null
}

ruff_command() {
  if [[ -x $root/.venv/bin/ruff ]]; then echo "$root/.venv/bin/ruff"
  elif command -v ruff >/dev/null; then echo ruff
  elif command -v uvx >/dev/null; then echo "uvx ruff"
  fi
}

has_eslint_config() {
  compgen -G "$root/eslint.config.*" >/dev/null || compgen -G "$root/.eslintrc*" >/dev/null
}

case $file in
  *.py|*.pyi)
    has_ruff_config || exit 0
    linter=$(ruff_command)
    [[ -n $linter ]] || exit 0
    output=$(cd "$root" && $linter check --quiet --no-fix "$file" 2>&1)
    ;;
  *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.vue)
    has_eslint_config && [[ -x $root/node_modules/.bin/eslint ]] || exit 0
    output=$(cd "$root" && node_modules/.bin/eslint --no-warn-ignored "$file" 2>&1)
    ;;
  *) exit 0 ;;
esac

status=$?
(( status == 0 )) && exit 0
printf 'Lint issues in %s (pre-existing ones may be outside your edit; fix only what you introduced):\n%s\n' "$file" "$output" >&2
exit 2
